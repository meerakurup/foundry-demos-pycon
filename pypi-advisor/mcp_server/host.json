{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "mcp": {
      "serverName": "PyPIAuditor",
      "serverVersion": "1.0.0",
      "instructions": "Tools for auditing Python packages from PyPI: version info, vulnerability checks, package comparison, and changelogs.",
      "system": {
        "webhookAuthorizationLevel": "Anonymous"
      }
    }
  }
}
